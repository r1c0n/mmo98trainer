<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>mmo98trainer</AssemblyName>
    <Product>MMO98 Trainer</Product>
    <Version>1.1.0</Version>
    <GameManagedPath Condition="'$(GameManagedPath)' == ''">$(MSBuildProjectDirectory)\libs</GameManagedPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <!-- Analyzer 1.0.8 only recognizes BepInEx 5's BaseUnityPlugin namespace.
         The verification harness checks our BepInEx 6 inheritance and plugin attribute. -->
    <NoWarn>$(NoWarn);BepInEx002</NoWarn>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>mmo98trainer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Unity.Mono" Version="6.0.0-be.788" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
	<PackageReference Include="UnityEngine.Modules" Version="6000.3.2" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="R3">
      <HintPath>$(GameManagedPath)\R3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(GameManagedPath)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SourceGeneration">
      <HintPath>$(GameManagedPath)\SourceGeneration.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ObservableCollections">
      <HintPath>$(GameManagedPath)\ObservableCollections.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManagedPath)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManagedPath)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameManagedPath)\Assembly-CSharp.dll') Or !Exists('$(GameManagedPath)\R3.dll') Or !Exists('$(GameManagedPath)\Unity.InputSystem.dll') Or !Exists('$(GameManagedPath)\SourceGeneration.dll') Or !Exists('$(GameManagedPath)\ObservableCollections.dll') Or !Exists('$(GameManagedPath)\UnityEngine.UI.dll') Or !Exists('$(GameManagedPath)\Unity.TextMeshPro.dll')"
           Text="Game references are missing. Run scripts/Sync-GameReferences.ps1 -GameDirectory &quot;path/to/MMO98&quot; or set GameManagedPath to MMO98_Data/Managed." />
  </Target>
</Project>
